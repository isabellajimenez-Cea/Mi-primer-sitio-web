
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background:#fca9d6
  color: #49394f;
  line-height: 1.6;
}

header {
  background: #e8c5f0;
  color: #673875;
  text-align: center;
  padding: 35px 15px;
}

main {
  max-width: 850px;
  margin: 25px auto;
  padding: 0 18px;
}

section {
  background: white;
  margin-bottom: 18px;
  padding: 20px;
  border-radius: 10px;
  border: 1px solid #edcfee;
}

h2 {
  color: #a052a0;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
  border-radius: 8px;
}

footer {
  text-align: center;
  padding: 18px;
  background: #ead9ef;
}


